{
  "manifest_version": 3,
  "name": "ScenePilot — Meta AI Series Studio",
  "version": "0.6.3",
  "description": "ตั้งค่าซีรีส์ จัดฉาก และส่งพร้อมต์วิดีโอเข้า Meta AI จากแถบข้าง",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.meta.ai/*",
    "https://meta.ai/*"
  ],
  "action": {
    "default_title": "เปิด ScenePilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.meta.ai/*",
        "https://meta.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
